# Environment variables for SLA Recovery Audit System

# Database
DATABASE_URL=sqlite:///./sla_recovery.db

# Authentication
SECRET_KEY=your-secret-key-change-in-production

# LLM Provider
OPENAI_API_KEY=sk-your-openai-api-key

# File storage
UPLOAD_DIR=./uploads

# API Server
API_HOST=localhost
API_PORT=8000
API_URL=http://localhost:8000

# Streamlit Frontend
FRONTEND_PORT=8501
